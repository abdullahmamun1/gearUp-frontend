# Base URL of the GearUp backend API (server-only — never expose to the browser)
BACKEND_API_URL=https://your-backend-url.vercel.app

# Must match the values in the backend's .env exactly.
# Used by proxy.ts to verify tokens and by the refresh flow.
JWT_ACCESS_SECRET=your_jwt_access_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret
